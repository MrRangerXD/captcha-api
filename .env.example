# ============================================================
#  CAPTCHA SOLVER — ENVIRONMENT
# ============================================================
#  Sirf Redis credentials chahiye. Baaki sab (OpenRouter key,
#  model, proxy, rate limits, admin password, discord cookies)
#  web UI -> Settings se set hote hain aur Redis me store hote hain.
# ============================================================


# ------------------------------------------------------------
# 1) REDIS  (REQUIRED)
# ------------------------------------------------------------
# Vercel pe: Storage -> Upstash Redis -> Connect
# Isse ye 2 vars AUTOMATIC inject ho jate hain, kuch type nahi karna:
#
#   KV_REST_API_URL
#   KV_REST_API_TOKEN
#
# Local dev ke liye neeche wale 2 use karo (same values):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternative naming (agar Upstash direct use kar rahe ho):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ------------------------------------------------------------
# 2) OPTIONAL — Runtime tuning
# ------------------------------------------------------------

# Kitni der tak task Redis me rahe (seconds). Default 900.
TASK_TTL=900

# Task cleanup ke baad kitne seconds tak result readable rahe. Default 900.
RESULT_TTL=900

# Discord/solver browser ko diya jane wala max time (ms). Default 180000
PROTOCOL_TIMEOUT=180000

# Concurrency guard — ek waqt me max browser. Default 1
MAX_CONCURRENCY=1


# ------------------------------------------------------------
# 3) OPTIONAL — LOCAL DEV ONLY
# ------------------------------------------------------------
# @sparticuz/chromium Linux binary hai. macOS/Windows pe
# `vercel dev` chalate waqt apna local Chrome do:

# macOS:
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Windows:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Linux:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Vercel pe ye khaali chhodo — @sparticuz/chromium khud handle karega.
PUPPETEER_EXECUTABLE_PATH=


# ------------------------------------------------------------
# 4) OPTIONAL — Browser behaviour
# ------------------------------------------------------------

# Headless mode. Vercel pe true rakho.
HEADLESS=true

# Browser window size
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=900

# Chrome binary ka temp extract path. Default /tmp
CHROMIUM_TMP_DIR=/tmp


# ------------------------------------------------------------
# 5) OPTIONAL — OpenRouter (agar UI se set nahi karna chahte)
# ------------------------------------------------------------
# UI -> Settings me daalna better hai. Ye fallback hain.
# Agar ye set honge to UI values ko override karenge.

# OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_REFERER=https://your-app.vercel.app
# OPENROUTER_TITLE=Captcha Solver


# ------------------------------------------------------------
# 6) OPTIONAL — Proxy (global fallback)
# ------------------------------------------------------------
# Residential proxy Discord ke liye almost must hai.
# UI -> Settings me bhi daal sakte ho.

# PROXY_SERVER=http://user:pass@host:port
# PROXY_USERNAME=
# PROXY_PASSWORD=


# ------------------------------------------------------------
# 7) OPTIONAL — Debugging
# ------------------------------------------------------------

# Verbose logs
DEBUG=false

# Vision model ko bhejne se pehle screenshots /tmp me save karo
SAVE_DEBUG_SHOTS=false