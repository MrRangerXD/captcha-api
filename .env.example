# ═══════════════════════════════════════════════════════
#  CAPTCHA SOLVER — ENV (fully filled, working)
#  .env.example -> .env karo, phir sirf 3 jagah apni value daalo
# ═══════════════════════════════════════════════════════

# Local SQLite DB file (no Redis required)
# Optional: change this path to wherever you want your .db file to live.
DB_PATH=./captcha.db

# ─── 1. ADMIN  [REQUIRED]  ← apna password ───
ADMIN_PASSWORD=changeme123

# ─── 2. API KEYS  [REQUIRED]  ← apni keys, comma se multiple ───
API_KEYS=cs_live_mykey123,cs_test_devkey

# ─── 3. OPENROUTER  [REQUIRED for image captcha]  ← apni key ───
OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REFERER=https://captcha-solver.vercel.app
OPENROUTER_TITLE=Captcha Solver

# ─── 4. LIMITS ───
RATE_LIMIT_PER_MIN=30
DAILY_LIMIT=2000
MAX_CONCURRENCY=1
TASK_TTL=900

# ─── 5. BROWSER ───
HEADLESS=true
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=900
PROTOCOL_TIMEOUT=180000
CHROMIUM_TMP_DIR=/tmp

# Local dev pe Chrome path, Vercel pe khaali chhodo
PUPPETEER_EXECUTABLE_PATH=

# ─── 7. PROXY (optional) ───
PROXY_SERVER=

# ─── 8. DEBUG ───
DEBUG=false